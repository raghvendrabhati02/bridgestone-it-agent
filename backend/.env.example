# ServiceNow Instance Settings (Instance subdomain only, e.g. dev12345, or full URL)
SERVICENOW_INSTANCE=your-instance-subdomain
SERVICENOW_USERNAME=your-username
SERVICENOW_PASSWORD=your-password
SERVICENOW_TABLE=incident
SERVICENOW_TIMEOUT=10.0

# Set to true to bypass real API calls and use local memory mock database
USE_MOCK_SERVICENOW=true
