# Database Connection (Resolves to the 'postgres' service container inside compose network)
DATABASE_URL=postgresql://postgres:password@postgres:5432/bridgestone_it_agent

# Redis Connection (Resolves to the 'redis' service container inside compose network)
REDIS_URL=redis://redis:6379/0

# JWT Auth Configuration
JWT_SECRET=bridgestone-it-agent-super-secret-key-123456

# AI Engine Key
GEMINI_API_KEY=your_gemini_api_key_here

# ServiceNow Adapter Configurations
USE_MOCK_SERVICENOW=true
SERVICENOW_URL=https://bridgestonemock.service-now.com/
SERVICENOW_INSTANCE_URL=https://bridgestonemock.service-now.com/
SERVICENOW_USERNAME=AI_Chatbot
SERVICENOW_PASSWORD=mock_password
SERVICENOW_CLIENT_ID=mock_client_id_123
SERVICENOW_CLIENT_SECRET=mock_client_secret_456

# Microsoft Graph Adapter Configurations
USE_MOCK_GRAPH=true
AZURE_TENANT_ID=mock_tenant_id_123
AZURE_CLIENT_ID=mock_client_id_456
AZURE_CLIENT_SECRET=mock_client_secret_789

# Azure AD / Entra ID Adapter Configurations
USE_MOCK_AD=true
