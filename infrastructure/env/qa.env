# AI Engine Key
GEMINI_API_KEY=AQ.Ab8RN6KSdEdVGPGDLCJBx4CqfzWyZ2f3wUiugce0EB8tosD24w

# ServiceNow Adapter Configurations (QA Endpoint)
USE_MOCK_SERVICENOW=false
