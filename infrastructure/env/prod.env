# Redis Connection (Resolves to the 'redis' service container inside compose network)
REDIS_URL=redis://redis:6379/0

# JWT Auth Configuration (Production Specific Secret)
JWT_SECRET=bridgestone-production-very-secure-jwt-signing-key-999888777

# AI Engine Key (Replace with Bridgestone Enterprise Gemini API Key in deployment pipeline)
GEMINI_API_KEY=AQ.Ab8RN6KSdEdVGPGDLCJBx4CqfzWyZ2f3wUiugce0EB8tosD24w

# ServiceNow Adapter Configurations (Production Endpoint)
USE_MOCK_SERVICENOW=false
SERVICENOW_URL=https://bridgestone.service-now.com/
SERVICENOW_INSTANCE_URL=https://bridgestone.service-now.com/
SERVICENOW_USERNAME=prod_servicenow_api_user
SERVICENOW_PASSWORD=prod_highly_secure_password_xyz
SERVICENOW_CLIENT_ID=prod_client_id_456
SERVICENOW_CLIENT_SECRET=prod_client_secret_789

# Microsoft Graph Adapter Configurations
USE_MOCK_GRAPH=false
