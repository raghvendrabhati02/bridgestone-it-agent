# ==============================================================================
# 1. APPLICATION CONFIGURATION
# ==============================================================================
APP_NAME=Bridgestone-IT-Agent
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO

# ==============================================================================
# 2. DATABASE CONFIGURATION
# ==============================================================================
# SQLite (development default):
DATABASE_URL=sqlite:///./bridgestone_it_agent.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/bridgestone_it_agent
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ==============================================================================
# 3. AI PROVIDER CONFIGURATION
# ==============================================================================
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Alternative Provider (Claude / Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ==============================================================================
# 4. AUTHENTICATION CONFIGURATION
# ==============================================================================
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_SECRET=change-this-to-a-secure-jwt-signing-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# 5. ITSM CONFIGURATION
# ==============================================================================
SERVICENOW_ENABLED=false
USE_MOCK_SERVICENOW=true
SERVICENOW_INSTANCE_URL=https://bridgestone.service-now.com/
SERVICENOW_TOKEN_URL=https://bridgestone.service-now.com/oauth_token.do
SERVICENOW_INCIDENT_ENDPOINT=https://bridgestone.service-now.com/api/now/table/incident
SERVICENOW_CLIENT_ID=your_servicenow_client_id
SERVICENOW_CLIENT_SECRET=your_servicenow_client_secret
SERVICENOW_USERNAME=AI_Chatbot
SERVICENOW_PASSWORD=your_servicenow_password
SERVICENOW_TIMEOUT=10
SERVICENOW_GRANT_TYPE=password
SERVICENOW_CALLER_ID=7adac95c3b96c71043d16e8693e45a40

# ==============================================================================
# 6. SECURITY CONFIGURATION
# ==============================================================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,https://bridgestone-ai-service-desk.vercel.app,https://bridgestone-ai-service-desk-backend.onrender.com

HSTS_ENABLED=false
HSTS_MAX_AGE=31536000
FRAME_OPTIONS=DENY
CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https://fastapi.tiangolo.com https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'

MAX_REQUEST_SIZE_KB=512
METRICS_PROTECTION=network

# ==============================================================================
# 7. LOGGING CONFIGURATION
# ==============================================================================
JSON_LOGGING=true
LOG_FORMAT=json
